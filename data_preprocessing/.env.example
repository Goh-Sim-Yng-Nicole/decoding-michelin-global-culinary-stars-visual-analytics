# Copy this file to .env and fill in your key
# Used by: preprocess_restaurant_data.py, scrape_google_reviews.py, sentiment_analysis.py

GOOGLE_PLACES_API_KEY=your_api_key_here

# Copy this file to .env and fill in your key
# Used by: embedded google link to tableau public
# Steps to Get a Google Maps API Key
# 1. Get a Google Maps API Key
# 2. Go to Google Cloud Console
# 3. Create a new project (or use existing)
# 4. Go to APIs & Services → Library
# 5. Search for "Maps Embed API" and enable it
# 6. Go to APIs & Services → Credentials → Create Credentials → API Key
# 7. Copy the key
GOOGLE_MAPS_EMBED_API_KEY=your_api_key_here